# ---------------------------------------------------------------------------
# Clipper settings. `clipper setup` copies this to .env; fill in the keys there.
# .env is git-ignored: never commit it.
# ---------------------------------------------------------------------------

# REQUIRED. Picks the moments, the layout and the titles.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL: posting to TikTok / YouTube Shorts / Instagram from the dashboard
# or `clipper post`. Free plan = 10 uploads a month: https://www.upload-post.com
# UPLOAD_POST_USER is the profile name you created there and connected your
# socials to.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Hardware. 1 = use the NVIDIA GPU (much faster on long streams). Needs a
# rebuild after changing: clipper setup
USE_GPU=0

# Whisper model on CPU. "small" is the sweet spot; "base" is faster.
WHISPER_MODEL=small

# ---- Moment signals (stack/overlay/youtube_signals.py) ---------------------
# Master switch for chat replay, Most-replayed, loudness and OBS markers.
YOUTUBE_SIGNALS=1
# Mic-loudness spikes (screams, laughter). Off if the mic is always loud.
LOUDNESS_SIGNAL=1
# Which audio track of a local OBS recording is the MIC (0 = first track).
# With OBS set to Track 1 = mix, Track 2 = mic: use 1.
MIC_AUDIO_TRACK=0
# Seconds between something happening and chat reacting. YouTube "normal
# latency" ~12; "ultra low latency" ~5.
CHAT_DELAY_SECONDS=12
# Give up downloading chat replay after this long (busy 8 h streams are slow);
# whatever arrived by then is still used.
CHAT_TIMEOUT_SECONDS=900

# ---- Pipeline --------------------------------------------------------------
# auto = Gemini picks a layout per video; screencast enables the
# gameplay-on-top / facecam-below layout for OBS streams with a webcam corner.
CLIPPER_LAYOUTS=auto,screencast
# Stream recordings are far bigger than OpenShorts' 2 GB default.
MAX_FILE_SIZE_MB=51200
# Self-hosted, behind your own machine: no rate limits needed.
RATE_LIMIT_ENABLED=0

# Optional, only if YouTube starts asking "Sign in to confirm you're not a bot":
# Netscape-format cookies exported from a browser signed in to a THROWAWAY account.
# YOUTUBE_COOKIES=

# Optional: run the moment picker on a local model instead of Gemini
# (Ollama etc.). Gemini is still used for layouts if the key is set.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
