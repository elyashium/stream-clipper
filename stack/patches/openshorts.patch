@@ -5464,9 +5464,30 @@ async def worker_done(job_id: str, request: Request):
     return {"ok": True}
 
 
+def _clipper_local_keys(request: Request):
+    """stream-clipper: hand the keys from .env to the dashboard on THIS machine,
+    so nobody has to paste them into the browser too. Self-host only, opt-in
+    (CLIPPER_LOCAL_KEYS=1), and never to another site: CORS is "*" in
+    self-host, so a page elsewhere could fetch this; such a request carries a
+    foreign Origin / Sec-Fetch-Site and gets nothing. The ports are bound to
+    127.0.0.1 by the clipper compose override, so the LAN cannot reach it."""
+    if BILLING_ENABLED or os.environ.get("CLIPPER_LOCAL_KEYS", "") != "1":
+        return None
+    origin = request.headers.get("origin")
+    site = request.headers.get("sec-fetch-site")
+    if site not in (None, "same-origin", "none"):
+        return None
+    if origin and not re.match(r"^https?://(localhost|127\.0\.0\.1)(:\d+)?$", origin):
+        return None
+    return {"gemini": os.environ.get("GEMINI_API_KEY", ""),
+            "uploadPost": os.environ.get("UPLOAD_POST_API_KEY", ""),
+            "uploadUser": os.environ.get("UPLOAD_POST_USER", "")}
+
+
 @app.get("/api/config")
-async def get_config():
+async def get_config(request: Request):
     return {
+        "localKeys": _clipper_local_keys(request),
         "youtubeUrlEnabled": not DISABLE_YOUTUBE_URL,
         "billingEnabled": BILLING_ENABLED,
         "googleAuthEnabled": bool(BILLING_ENABLED and cloud.settings.google_auth_enabled),
